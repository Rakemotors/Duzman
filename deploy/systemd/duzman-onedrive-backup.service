[Unit]
Description=Duzman weekly OneDrive backup upload
Documentation=https://github.com/Rakemotors/Duzman/blob/main/deploy/README.md
Requires=network-online.target
After=network-online.target duzman-backup.service

[Service]
Type=oneshot
WorkingDirectory=/opt/duzman
User=duzman
Group=duzman
EnvironmentFile=/opt/duzman/.env
Environment=RCLONE_CONFIG=/etc/duzman/rclone/rclone.conf
ExecStart=/opt/duzman/deploy/onedrive_upload.sh

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/duzman/backups /etc/duzman/rclone

[Install]
WantedBy=multi-user.target
